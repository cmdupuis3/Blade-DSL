// TEST: AD Fma Intrinsic
import ad as ad
// ============================================================================
// fma(a, b, c) under both AD modes. The fused node's value is a*b + c with
// one rounding, and its derivative is exactly that of a*b + c: partials
// b, a, 1 (GradCommon.ternaryMathIntrinsics). The sweeps differentiate it
// through those partials; the derivative arithmetic is ordinary unfused
// arithmetic, since a gradient needs no single rounding -- only the forward
// value does.
//   f(x) = fma(x, x, 3x) = x^2 + 3x,  f'(x) = 2x + 3;  at x = 2: (10, 7)
// ============================================================================
function f(x: Float) -> Float = fma(x, x, 3.0 * x)
let (fv, dfdx) = ad.grad(f)(2.0)
// EXPECT: fv = 10.0
// EXPECT: dfdx = 7.0

// Forward mode: the tangent along dx = 1 is the same 7.
let (jv, jt) = ad.jvp(f)(2.0, 1.0)
// EXPECT: jv = 10.0
// EXPECT: jt = 7.0
