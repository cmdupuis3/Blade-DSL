// TEST: AD Recursive Array Carry, Trajectory Loss At 509
import ad as ad
// ============================================================================
// The additive carry s(n) = s(n-1) + w(n-1) * xs(n-1) differentiated in
// reverse mode through the DIRECT loop (docs/plans/structural/01): the
// adjoint is the same loop run backwards, O(n). Same shape as 027 at a larger extent: with the triangular unroll this cost 129k increments per sweep; the direct loop costs 508.
// Analytic gradient: d/dw(k) sum_n s(n) = xs(k) * (N - 1 - k).
// Non-power-of-two extent on purpose; pins are exact products and sums of
// short decimals.
// ============================================================================
let xs = 2.0 + 0.5 * Float64(0..509)
function h(w: Array<Float like Idx<509>>) -> Float = {
    let rec s: Array<Float like Idx<509>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: 0.0
        | prefix :: n -> prefix :: prefix(n - 1) + w(n - 1) * xs(n - 1)
    reduce(s, (+))
}
let w0 = 1.0 + 0.001 * Float64(0..509)
let mut dh = 0.0 * Float64(0..509)
let hv = ad.grad(h)(w0, dh)
let g0 = dh(0)
let gmid = dh(254)
let gpen = dh(507)
let glast = dh(508)
let gsum = reduce(dh, (+))
// EXPECT: hv = 14001803.086
// EXPECT: g0 = 1016
// EXPECT: gmid = 32766
// EXPECT: gpen = 255.5
// EXPECT: glast = 0
// EXPECT: gsum = 11183239
