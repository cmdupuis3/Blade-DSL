// TEST: A Tile Grouping Names The Slots In Slot Order (rejects)
// The fixed order of decisions D8/D10: `segments(C1, C0)` over an array whose
// slots are (I0, I1) does not match, and is refused rather than transposed.
// ERROR: BL3999
// ERROR-CONTAINS: in that order
type I0 = Idx<10>
type I1 = Idx<6>
type C0 = Chunked<I0, 4>
type C1 = Chunked<I1, 4>
let a: Array<Float like I0, I1> = method_for(range<I0>, range<I1>) <@> lambda(i, j) -> Float64(i) + Float64(j) |> compute
let tiles = segments(C1, C0)
let g = group_by(a, tiles)
