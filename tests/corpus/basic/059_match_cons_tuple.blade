// TEST: Match Cons Pattern On A Tuple
// ============================================================================
// `head :: tail` in MATCH position. It used to fall into the emitter's
// catch-all, which rendered the arm body with no bindings at all -- `| h ::
// rest -> h` emitted `double r = __v1;`, a dangling identifier. The
// interpreter has always matched cons correctly, so this was a twin
// divergence too.
//
// The remainder follows the same rule `let head :: tail = t` does: Blade has
// no 1-tuple (`(x)` IS `x`), so a PAIR's remainder is the bare element, and
// a longer tuple's remainder is a tuple of what is left.

let t = (1.0, 2.0, 3.0)
let head_only = match t with
    | h :: rest -> h
// EXPECT: head_only = 1

// The remainder taken apart in the same pattern: two more slots, so the
// tail is a 2-tuple and destructures.
let all = match t with
    | h :: (a, b) -> h + a * 10.0 + b * 100.0
// EXPECT: all = 321

// Nested cons: peel twice. The second peel leaves ONE slot, which is the
// bare element -- `c` is a Float64, not a 1-tuple.
let peeled = match t with
    | a :: b :: c -> a * 100.0 + b * 10.0 + c
// EXPECT: peeled = 123

// The pair case, where the remainder degrades: `rest` is the second element.
let pair = (4.0, 5.0)
let sum2 = match pair with
    | h :: rest -> h + rest
// EXPECT: sum2 = 9

// A literal HEAD makes the cons arm refutable, so the fall-through is real.
// (Integers -- float patterns are not parser-reachable.)
let ti = (1, 2, 3)
let picked = match ti with
    | 9 :: rest -> 0
    | h :: rest -> h * 2
// EXPECT: picked = 2
