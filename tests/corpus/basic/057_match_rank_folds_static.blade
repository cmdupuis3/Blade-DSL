// TEST: Match On Rank Folds Statically
// ============================================================================
// `rank(a)` is a compile-time constant, so a match over it selects its arm
// at compile time -- the fold that used to live only inside the arity
// specializer now runs module-wide, and no ternary over a decided question
// survives to the emitted code. Values prove the right arm was taken.

type I = Idx<3>
let a: Array<Float like I> = [1.0, 2.0, 3.0]
let x = 4.0

let y = match rank(a) with
    | 0 -> 100
    | _ -> 200
// EXPECT: y = 200

let z = match rank(x) with
    | 0 -> 100
    | _ -> 200
// EXPECT: z = 100
