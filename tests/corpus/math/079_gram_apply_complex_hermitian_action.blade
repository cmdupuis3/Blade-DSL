// TEST: Math gram_apply: complex factors conjugate the second (Hermitian action)
// gram_apply(A, A, v) = A (A^H v): the conjugation sits on the B factor,
// exactly as gram(A, A) = A A^H, so the action agrees with the Hermitian Gram
// matrix applied the long way (decompact, row prodsum) -- the one place two
// correct implementations could silently disagree (docs/plans/structural/05,
// D4). Integer-valued parts, so the pins are exact in both lanes; the routed
// arm is cblas ?gemv with ConjTrans for the first half.
let A: Array<Complex128 like Idx<3>, Idx<2>> = [
    [complex(1.0, 1.0), complex(2.0, 0.0)],
    [complex(0.0, 1.0), complex(1.0, -1.0)],
    [complex(2.0, 2.0), complex(0.0, 3.0)]
]
let v: Array<Complex128 like Idx<3>> = [complex(1.0, 0.0), complex(0.0, 1.0), complex(1.0, 1.0)]
let y = gram_apply(A, A, v)
// EXPECT: y = [(15, 1), (3, 0), (20, 22)]
let G = gram(A, A)
let Gd = decompact(G, 0)
let y_ref = method_for(Gd) <@> lambda(row) -> prodsum(row, v) |> compute
let dev = reduce(y - y_ref, (+))
// EXPECT: dev = (0, 0)
