// TEST: Auto-Lowered Grouped Peel Over Positional Keys, With An Init
// `Idx<N>` keys make the group count STATIC -- and that is exactly when
// EMPTY groups become possible (dynamic discovery only ever manufactures a
// group it saw a row for). The language already decides the empty fold:
// sql.md 10 -- `reduce(A, op, init)` returns `init` for an empty operand.
//
// So the rewrite accepts a per-group SUM over positional keys when the peel
// carries an explicit init, and folds the init contribution in EXACTLY:
// `L = init * N + sum_i v_i`, N the static group count. Here group 1 takes
// no rows at all, so its whole contribution IS the init -- and the natural
// peel, evaluated outside differentiated code, agrees to the bit.
import ad as ad

type R = Idx<4>
type GK = Idx<3>

function loss(v: Array<Float64 like R>, pk: Array<GK like R>) -> Float = {
    let gk = group_keys(pk)
    let g = group_by(v, gk)
    let m = method_for(g) <@> lambda(r: Array<Float64 like RaggedIdx<_>>) -> reduce(r, (+), 7.0) |> compute
    reduce(m, (+))
}

let vv: Array<Float64 like R> = [10.0, 20.0, 30.0, 40.0]
// group 0 takes rows 1,3; group 1 takes NOTHING; group 2 takes rows 0,2
let sk: Array<GK like R> = [2, 0, 2, 0]

// the natural peel outside AD: the empty group returns its init
let pgk = group_keys(sk)
let pg = group_by(vv, pgk)
let pm = method_for(pg) <@> lambda(r: Array<Float64 like RaggedIdx<_>>) -> reduce(r, (+), 7.0) |> compute
let pL = reduce(pm, (+))
// EXPECT: pm = [67, 7, 47]
// EXPECT: pL = 121

let mut dv = [0.0, 0.0, 0.0, 0.0]
let gv = ad.grad(loss)(vv, sk, dv)
// 100 of data + 3 groups x 7.0 of init, matching the peel exactly
// EXPECT: gv = 121
// EXPECT: dv = [1, 1, 1, 1]
let agree = gv - pL
// EXPECT: agree = 0

let (jp, jt) = ad.jvp(loss)(vv, sk, [1.0, 1.0, 1.0, 1.0])
// EXPECT: jp = 121
// EXPECT: jt = 4
