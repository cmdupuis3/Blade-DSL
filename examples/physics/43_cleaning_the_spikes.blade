// TEST: Physics -- Cleaning the Spikes: Eigenvector-Resolved Estimation
// ============================================================================
// Ex 31's honest boundary, crossed. Free deconvolution cleans flat-bulk
// spectra (74x there) but gained only ~1.4x on SPIKED truths -- the error
// lives in spike rotation, not moment bias, and moments carry no basis
// information. The named next rung was Ledoit-Peche eigenvector-resolved
// cleaning; it needed an eigensolver, and the math module now has one
// (m.eigh -- cyclic Jacobi, descending eigenvalues, eigenvector columns).
// Setup: a fuzzy chain of d = 40 registers whose COLLECTIVE modes are the
// chain's sine normal modes u_k(i) = sqrt(2/d) sin(pi k (i+1/2)/d) --
// exactly orthogonal (DST identity), built in-language from sin(). Four
// latent modes with strengths l = (10, 5, 2.5, 1.3) ride on unit white
// register fuzz: truth Sigma = I + sum (l_k - 1) u_k u_k^T. The observer
// takes N = 160 looks (gamma = d/N = 1/4) at +-1 data (emitted tables; the
// estimate E = X X^T / N is exact integer arithmetic over them).
// FINDINGS (pinned):
//   * THE BBP WALL, MEASURED. Detectability threshold l* = 1 + sqrt(gamma)
//     = 1.5. Modes 1-3 stick out of the Marchenko-Pastur bulk, BIASED
//     (lam^ = l(1 + gamma/(l-1)): 10.42/5.45/2.86 vs BBP 10.28/5.31/2.92)
//     and ROTATED (squared overlaps 0.961/0.909/0.716 vs the BBP law
//     (1 - gamma/(l-1)^2)/(1 + gamma/(l-1)) = 0.970/0.926/0.762). Mode 4
//     (l = 1.3 < l*) is SWALLOWED: its best overlap with ANY sample
//     eigenvector is 0.133 (vs 1/d = 0.025 floor), and the top bulk
//     eigenvalue sits at 2.03, under the edge (1+sqrt gamma)^2 = 2.25.
//     Below the wall a collective mode is INVISIBLE to the observer's
//     spectrum -- a detectability phase transition, epistemic not
//     dynamical (the wall theme, ex 30/33/37 flavor).
//   * SPIKE STRENGTHS RECOVERED by inverting the BBP map on the visible
//     eigenvalues: l^ = ((x+1-gamma) + sqrt((x+1-gamma)^2 - 4x))/2 gives
//     (10.14, 5.14, 2.44) vs true (10, 5, 2.5) -- 1.4%/2.9%/2.5%.
//   * THE CLEANING LADDER (Frobenius error to truth, sample basis kept):
//     raw 18.09 > naive-with-TRUE-strengths 8.53 > RIE 8.26 > oracle
//     bound v^T Sigma v = 8.15. Eigenvector-resolved RIE (eigenvalue ->
//     1 + (l^-1) x overlap-law, bulk -> 1) improves raw 2.19x and lands
//     within 1.3% of the information bound. THE MORAL PIN: RIE BEATS
//     god-given true strengths -- the sample eigenvectors are rotated,
//     and the Ledoit-Peche value prices the rotation in; plugging in the
//     truth overshoots. Knowing l is worth less than shrinking right.
//   * MOMENTS WERE NEVER THE OBSTACLE. Ex 31's free deconvolution, run
//     here, cleans the spectral moment fine (m2 relative error 13.2% ->
//     1.9%) -- and cannot move the matrix error at all: moments carry no
//     eigenvectors. The 2.19x came from basis information alone.
//   * The sub-threshold mode's strength is the floor's fine print: its
//     direction is lost, (l4 - 1)^2 = 0.09 of error is irreducible.
// Certification: the +-1 tables are data (any data is legal data); the
// mode geometry, truth Sigma, estimator, eigensolve, inversion formulas,
// and every error number are computed in-language. Two-route discipline:
// all pins verified against an independent F# Jacobi + analytic BBP route
// before pinning (eigenvalues agree ~1e-13; squared overlaps sign-immune).
// ============================================================================
import math as m

// CSV-backed since 2026-07-19: the 40 x 160 spiked tracks and 4 x 160
// ground truth live in data/43_{ZT,GT}.csv (bit-identical extraction of
// the former inline literals). Run from THIS directory so the relative
// paths resolve — see providers/CsvProviderSpec.md.
import csv as csvd
let ZT_h = csvd.load("data/43_ZT.csv")
let ZT: Array<Float64 like Idx<40>, Idx<160>> = ZT_h.vars.data |> csvd.read
let GT_h = csvd.load("data/43_GT.csv")
let GT: Array<Float64 like Idx<4>, Idx<160>> = GT_h.vars.data |> csvd.read
// ---- the chain's normal modes, in-language (DST: exactly orthogonal) ----
function eqInd(a: Int64, b: Int64) -> Float64 = if a + 1 > b then (if a < b + 1 then 1.0 else 0.0) else 0.0
// The mode shapes are arithmetic in the site ordinal: lift over one shared
// half-offset axis instead of four identical range loops.
let uax = Float64(0..40) + 0.5
let U1 = 0.223606797749979 * sin(3.14159265358979 * 1.0 * uax / 40.0)
let U2 = 0.223606797749979 * sin(3.14159265358979 * 2.0 * uax / 40.0)
let U3 = 0.223606797749979 * sin(3.14159265358979 * 3.0 * uax / 40.0)
let U4 = 0.223606797749979 * sin(3.14159265358979 * 4.0 * uax / 40.0)

// ---- data: X = white fuzz + sqrt(l_k - 1) u_k g_k ; estimate E = X X^T / N ----
let X = method_for(range<Idx<40>>) <*> method_for(range<Idx<160>>) <@> lambda(i: Int64, t: Int64) -> ZT(i, t) + 3.0 * U1(i) * GT(0, t) + 2.0 * U2(i) * GT(1, t) + 1.22474487139159 * U3(i) * GT(2, t) + 0.547722557505166 * U4(i) * GT(3, t) |> compute
let ES: Array<Float64 like Idx<40>, Idx<40>> = method_for(X, X) <@> lambda(x: Array<Float64 like Idx<160>>, y: Array<Float64 like Idx<160>>) -> prodsum(x, y) / 160.0 |> compute

// ---- truth ----
let SIG = method_for(range<Idx<40>>) <*> method_for(range<Idx<40>>) <@> lambda(i: Int64, j: Int64) -> eqInd(i, j) + 9.0 * U1(i) * U1(j) + 4.0 * U2(i) * U2(j) + 1.5 * U3(i) * U3(j) + 0.3 * U4(i) * U4(j) |> compute

// ---- the eigensolve ----
let (Q, LAM) = m.eigh(ES)
let lam1 = LAM(0)
let lam2 = LAM(1)
let lam3 = LAM(2)
let lam4 = LAM(3)

// eigenvectors as rows: QT(c) is column c of Q (the c-th eigenvector);
// used by the overlap sweeps here and the oracle bound below.
let QT = method_for(range<Idx<40>>) <*> method_for(range<Idx<40>>) <@> lambda(i: Int64, j: Int64) -> Q(j, i) |> compute

// ---- overlaps with the true modes (squared; sign-immune) ----
// each overlap is an eigenvector-column * true-mode inner product, squared:
// materialize column c of Q in index order, then prodsum reproduces the
// by-hand dot product exactly (same summation order).
let o1 = {
    let c = method_for(range<Idx<40>>) <@> lambda(i) -> Q(i, 0) |> compute
    let v = prodsum(c, U1)
    v * v
}
let o2 = {
    let c = method_for(range<Idx<40>>) <@> lambda(i) -> Q(i, 1) |> compute
    let v = prodsum(c, U2)
    v * v
}
let o3 = {
    let c = method_for(range<Idx<40>>) <@> lambda(i) -> Q(i, 2) |> compute
    let v = prodsum(c, U3)
    v * v
}
// sub-threshold mode: best overlap with ANY sample eigenvector -- the
// per-eigenvector squared overlaps as one row sweep, then a max fold
let OV4 = method_for(QT) <@> lambda(row: Array<Float64 like Idx<40>>) -> prodsum(row, U4) ^ 2.0 |> compute
let omax4 = reduce(OV4, lambda(a, b) -> if a > b then a else b)

// ---- invert the BBP map on the visible spikes: l^ from lam^ ----
let b1 = lam1 + 0.75
let lh1 = (b1 + sqrt(b1 * b1 - 4.0 * lam1)) / 2.0
let b2 = lam2 + 0.75
let lh2 = (b2 + sqrt(b2 * b2 - 4.0 * lam2)) / 2.0
let b3 = lam3 + 0.75
let lh3 = (b3 + sqrt(b3 * b3 - 4.0 * lam3)) / 2.0

// ---- cleaned eigenvalue vectors ----
// RIE: spike -> 1 + (l^ - 1) * overlap-law(l^); bulk -> 1 (white bulk)
let DRIE = method_for(range<Idx<40>>) <@> lambda(k: Int64) -> {
    let x = LAM(k)
    let b = x + 0.75
    let d0 = b * b - 4.0 * x
    let dsc = if d0 > 0.0 then d0 else 0.0
    let lh = (b + sqrt(dsc)) / 2.0
    let oh = (1.0 - 0.25 / ((lh - 1.0) * (lh - 1.0))) / (1.0 + 0.25 / (lh - 1.0))
    if x > 2.250001 then 1.0 + (lh - 1.0) * oh else 1.0
} |> compute
// naive: the TRUE strengths on the top three, 1 on the rest
let DNAI = method_for(range<Idx<40>>) <@> lambda(k: Int64) -> (if k < 1 then 10.0 else (if k < 2 then 5.0 else (if k < 3 then 2.5 else 1.0))) |> compute

// ---- the ladder: Frobenius error to truth. Each cleaned matrix is the
// eigenbasis reconstruction Q diag(d) Q^T -- a row-pair prodsum sweep of
// the eigenvalue-scaled rows against Q -- and each Frobenius error is a
// flat-raveled squared-deviation fold (i-major, j-inner: the exact scalar
// accumulation order, so the pins are bit-for-bit stable) ----
let DRW = method_for(range<Idx<1600>>) <@> lambda(u) -> {
    let i = u / 40
    let j = u - 40 * i
    (ES(i, j) - SIG(i, j)) ^ 2.0
} |> compute
let errRaw = reduce(DRW, (+))
let QDN = method_for(range<Idx<40>>) <*> method_for(range<Idx<40>>) <@> lambda(i: Int64, k: Int64) -> Q(i, k) * DNAI(k) |> compute
let RCN = method_for(QDN, Q) <@> lambda(ua: Array<Float64 like Idx<40>>, ub: Array<Float64 like Idx<40>>) -> prodsum(ua, ub) |> compute
let DNV = method_for(range<Idx<1600>>) <@> lambda(u) -> {
    let i = u / 40
    let j = u - 40 * i
    (RCN(i, j) - SIG(i, j)) ^ 2.0
} |> compute
let errNaive = reduce(DNV, (+))
let QDR = method_for(range<Idx<40>>) <*> method_for(range<Idx<40>>) <@> lambda(i: Int64, k: Int64) -> Q(i, k) * DRIE(k) |> compute
let RCR = method_for(QDR, Q) <@> lambda(ua: Array<Float64 like Idx<40>>, ub: Array<Float64 like Idx<40>>) -> prodsum(ua, ub) |> compute
let DRV = method_for(range<Idx<1600>>) <@> lambda(u) -> {
    let i = u / 40
    let j = u - 40 * i
    (RCR(i, j) - SIG(i, j)) ^ 2.0
} |> compute
let errRIE = reduce(DRV, (+))
// oracle bound: eigenvalue k -> v_k^T Sigma v_k, best possible in this basis
// (QT, the eigenvector-row matrix, is defined by the overlap block above)
let M1 = method_for(QT, SIG) <@> lambda(x: Array<Float64 like Idx<40>>, y: Array<Float64 like Idx<40>>) -> prodsum(x, y) |> compute
let MOR = method_for(M1, QT) <@> lambda(x: Array<Float64 like Idx<40>>, y: Array<Float64 like Idx<40>>) -> prodsum(x, y) |> compute
let QDO = method_for(range<Idx<40>>) <*> method_for(range<Idx<40>>) <@> lambda(i: Int64, k: Int64) -> Q(i, k) * MOR(k, k) |> compute
let RCO = method_for(QDO, Q) <@> lambda(ua: Array<Float64 like Idx<40>>, ub: Array<Float64 like Idx<40>>) -> prodsum(ua, ub) |> compute
let DOV = method_for(range<Idx<1600>>) <@> lambda(u) -> {
    let i = u / 40
    let j = u - 40 * i
    (RCO(i, j) - SIG(i, j)) ^ 2.0
} |> compute
let errORC = reduce(DOV, (+))
let impF = errRaw / errRIE

// ---- ex 31's route, for contrast: moments clean fine, the matrix does not move ----
let em1 = reduce(LAM, (+)) / 40.0
let em2 = prodsum(LAM, LAM) / 40.0
let dm2 = em2 - 0.25 * em1 * em1
let SQ2 = method_for(range<Idx<1600>>) <@> lambda(u) -> {
    let i = u / 40
    let j = u - 40 * i
    SIG(i, j) ^ 2.0
} |> compute
let tm2 = reduce(SQ2, (+)) / 40.0
let m2errRaw = abs(em2 - tm2) / tm2
let m2errDec = abs(dm2 - tm2) / tm2

// ---- verdicts ----
let wallV = if omax4 < 0.3 then (if lam4 < 2.25 then "MODE4_BEHIND_THE_BBP_WALL" else "NO") else "NO"
let recV = if abs(lh1 - 10.0) < 0.5 then (if abs(lh2 - 5.0) < 0.25 then (if abs(lh3 - 2.5) < 0.125 then "SPIKES_RECOVERED_TO_5PCT" else "NO") else "NO") else "NO"
let ladderV = if errRaw > errNaive then (if errNaive > errRIE then (if errRIE > errORC then "LADDER_RAW_NAIVE_RIE_ORACLE" else "NO") else "NO") else "NO"
let moralV = if errRIE < errNaive then "SHRINKAGE_BEATS_TRUE_STRENGTHS" else "NO"
let boundV = if errRIE / errORC < 1.05 then "WITHIN_5PCT_OF_INFORMATION_BOUND" else "NO"
let momentV = if m2errRaw > 0.1 then (if m2errDec < 0.05 then "MOMENTS_CLEAN_MATRIX_UNMOVED" else "NO") else "NO"

// the wall, the bias, the rotation, the inversion, the ladder, the moral:
// EXPECT: lam1 = 10.4162049054318
// EXPECT: lam2 = 5.45320035457485
// EXPECT: lam3 = 2.86125463673256
// EXPECT: lam4 = 2.02989146991325
// EXPECT: o1 = 0.961049105414985
// EXPECT: o2 = 0.908517471962606
// EXPECT: o3 = 0.716454319571361
// EXPECT: omax4 = 0.132710418666036
// EXPECT: wallV = "MODE4_BEHIND_THE_BBP_WALL"
// EXPECT: lh1 = 10.1388491634199
// EXPECT: lh2 = 5.142855503104
// EXPECT: lh3 = 2.43731978792567
// EXPECT: recV = "SPIKES_RECOVERED_TO_5PCT"
// EXPECT: errRaw = 18.093638057781
// EXPECT: errNaive = 8.52656674229733
// EXPECT: errRIE = 8.26056682656837
// EXPECT: errORC = 8.15273507031312
// EXPECT: impF = 2.19036277263524
// EXPECT: ladderV = "LADDER_RAW_NAIVE_RIE_ORACLE"
// EXPECT: moralV = "SHRINKAGE_BEATS_TRUE_STRENGTHS"
// EXPECT: boundV = "WITHIN_5PCT_OF_INFORMATION_BOUND"
// EXPECT: em1 = 1.38085914520562
// EXPECT: em2 = 4.78139545080815
// EXPECT: dm2 = 4.30470245608365
// EXPECT: tm2 = 4.2235
// EXPECT: m2errRaw = 0.13209315752531
// EXPECT: m2errDec = 0.0192263421531074
// EXPECT: momentV = "MOMENTS_CLEAN_MATRIX_UNMOVED"
