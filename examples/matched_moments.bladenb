        | prefix :: n -> prefix :: calrow3tr(n)
    t
}
let __c3te = {
    let rec t: Array<Float like Idx<200>, Idx<15>> =
        match t with
        | zero -> zero
        | prefix :: n -> prefix :: calrow3te(n)
    t
}
let static NW3 = 64
let static NW3X2 = 128
let static SW3 = 129
function score3(__s: Array<Float like Idx<SW3>>, n: Int, c: Int) -> Float = {
    let rec a: Array<Float like Idx<15>> =
        match a with
        | zero -> zero
        | prefix :: j -> prefix :: __s(c * 15 + j) * __c3tr(n, j)
    reduce(a, (+)) + __s(60 + c)
}
function sqe3(__s: Array<Float like Idx<SW3>>, n: Int) -> Float = {
