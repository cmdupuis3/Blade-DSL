// ---- rung +K3+K4: the full jet ---------------------------------------------
function x4_tr(n: Int) -> Array<Float like IrrepsIdx<ISPEC4>> =
    [__jtr(n, 0), __jtr(n, 16),
     __m1tr(n, 0), __m1tr(n, 1), __m1tr(n, 2),
     __jtr(n, 6), __jtr(n, 7), __jtr(n, 8),
     __jtr(n, 1), __jtr(n, 2), __jtr(n, 3), __jtr(n, 4), __jtr(n, 5),
     __jtr(n, 17), __jtr(n, 18), __jtr(n, 19), __jtr(n, 20), __jtr(n, 21),
     __jtr(n, 9), __jtr(n, 10), __jtr(n, 11), __jtr(n, 12), __jtr(n, 13), __jtr(n, 14), __jtr(n, 15),
     __jtr(n, 22), __jtr(n, 23), __jtr(n, 24), __jtr(n, 25), __jtr(n, 26), __jtr(n, 27), __jtr(n, 28), __jtr(n, 29), __jtr(n, 30)]
function x4_te(n: Int) -> Array<Float like IrrepsIdx<ISPEC4>> =
    [__jte(n, 0), __jte(n, 16),
     __m1te(n, 0), __m1te(n, 1), __m1te(n, 2),
     __jte(n, 6), __jte(n, 7), __jte(n, 8),
     __jte(n, 1), __jte(n, 2), __jte(n, 3), __jte(n, 4), __jte(n, 5),
     __jte(n, 17), __jte(n, 18), __jte(n, 19), __jte(n, 20), __jte(n, 21),
     __jte(n, 9), __jte(n, 10), __jte(n, 11), __jte(n, 12), __jte(n, 13), __jte(n, 14), __jte(n, 15),
     __jte(n, 22), __jte(n, 23), __jte(n, 24), __jte(n, 25), __jte(n, 26), __jte(n, 27), __jte(n, 28), __jte(n, 29), __jte(n, 30)]
let __e4tr = {
    let rec t: Array<Float like Idx<400>, Idx<18>> =
        match t with
        | zero -> zero
        | prefix :: n -> prefix :: chans4(x4_tr(n))
    t
}
let __e4te = {
    let rec t: Array<Float like Idx<200>, Idx<18>> =
        match t with
        | zero -> zero
        | prefix :: n -> prefix :: chans4(x4_te(n))
    t
}
function cal4mu(j: Int) -> Float = {
    let rec a: Array<Float like Idx<400>> =
        match a with
        | zero -> zero
        | prefix :: n -> prefix :: __e4tr(n, j)
    reduce(a, (+)) / 400.0
}
function cal4sd(j: Int) -> Float = {
    let mu = cal4mu(j)
    let rec a: Array<Float like Idx<400>> =
        match a with
        | zero -> zero
        | prefix :: n -> prefix :: (__e4tr(n, j) - mu) * (__e4tr(n, j) - mu)
    sqrt(reduce(a, (+)) / 400.0)
}
let __mu4 = {
    let rec m: Array<Float like Idx<18>> =
        match m with
        | zero -> zero
        | prefix :: j -> prefix :: cal4mu(j)
    m
}
let __sc4 = {
    let rec m: Array<Float like Idx<18>> =
        match m with
        | zero -> zero
        | prefix :: j -> prefix :: (if cal4sd(j) < 0.00000001 then 0.0 else 1.0 / cal4sd(j))
    m
}
function calrow4tr(n: Int) -> Array<Float like Idx<18>> = {
    let rec o: Array<Float like Idx<18>> =
        match o with
        | zero -> zero
        | prefix :: j -> prefix :: (__e4tr(n, j) - __mu4(j)) * __sc4(j)
    o
}
function calrow4te(n: Int) -> Array<Float like Idx<18>> = {
    let rec o: Array<Float like Idx<18>> =
        match o with
        | zero -> zero
        | prefix :: j -> prefix :: (__e4te(n, j) - __mu4(j)) * __sc4(j)
    o
}
let __c4tr = {
    let rec t: Array<Float like Idx<400>, Idx<18>> =
        match t with
        | zero -> zero
        | prefix :: n -> prefix :: calrow4tr(n)
    t
}
let __c4te = {
    let rec t: Array<Float like Idx<200>, Idx<18>> =
        match t with
        | zero -> zero
        | prefix :: n -> prefix :: calrow4te(n)
    t
}
let static NW4 = 76
let static NW4X2 = 152
let static SW4 = 153
function score4(__s: Array<Float like Idx<SW4>>, n: Int, c: Int) -> Float = {
    let rec a: Array<Float like Idx<18>> =
        match a with
        | zero -> zero
        | prefix :: j -> prefix :: __s(c * 18 + j) * __c4tr(n, j)
    reduce(a, (+)) + __s(72 + c)
}
function sqe4(__s: Array<Float like Idx<SW4>>, n: Int) -> Float = {
    let e0 = score4(__s, n, 0) - __ytr(n, 0)
    let e1 = score4(__s, n, 1) - __ytr(n, 1)
    let e2 = score4(__s, n, 2) - __ytr(n, 2)
    let e3 = score4(__s, n, 3) - __ytr(n, 3)
    e0 * e0 + e1 * e1 + e2 * e2 + e3 * e3
}
function loss4(__s: Array<Float like Idx<SW4>>, b: Int) -> Float = {
    let rec errs: Array<Float like Idx<100>> =
        match errs with
        | zero -> zero
        | prefix :: j -> prefix :: sqe4(__s, j * 4 + b)
    reduce(errs, (+)) / 100.0
}
function pick4(__s: Array<Float like Idx<SW4>>, base: Int, k: Int) -> Float = __s(base + k)
function blk4w(__s: Array<Float like Idx<SW4>>, base: Int) -> Array<Float like Idx<NW4>> = {
    let rec o: Array<Float like Idx<76>> =
        match o with
        | zero -> zero
        | prefix :: k -> prefix :: pick4(__s, base, k)
