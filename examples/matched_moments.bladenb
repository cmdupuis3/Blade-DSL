// %% [markdown]
// ## The measured matrix
//
// Per-rung, per-class test hits out of 50 — the table the prediction cell
// committed to. A hit is a strict argmax agreeing with the label (the tetris
// notebook's counting; no ties occur, the biases see to that). The K <= 2
// row's total of exactly 50 is theorem 2's accuracy consequence, measured.

// %%
function hit(sc0: Float, sc1: Float, sc2: Float, sc3: Float, __yr: Array<Float like Klass>) -> Float = {
    let st = sc0 * __yr(0) + sc1 * __yr(1) + sc2 * __yr(2) + sc3 * __yr(3)
    let ng = ind(sc0, st) + ind(sc1, st) + ind(sc2, st) + ind(sc3, st)
    if ng < 0.5 then 1.0 else 0.0
}
function tescore0(n: Int, c: Int) -> Float = {
    let rec a: Array<Float like Idx<9>> =
        match a with
        | zero -> zero
        | prefix :: j -> prefix :: __f0(c * 9 + j) * __c0te(n, j)
    reduce(a, (+)) + __f0(36 + c)
}
function tescore2(n: Int, c: Int) -> Float = {
    let rec a: Array<Float like Idx<12>> =
        match a with
        | zero -> zero
        | prefix :: j -> prefix :: __f2(c * 12 + j) * __c2te(n, j)
    reduce(a, (+)) + __f2(48 + c)
}
function tescore3(n: Int, c: Int) -> Float = {
    let rec a: Array<Float like Idx<15>> =
        match a with
        | zero -> zero
        | prefix :: j -> prefix :: __f3(c * 15 + j) * __c3te(n, j)
    reduce(a, (+)) + __f3(60 + c)
}
function tescore4(n: Int, c: Int) -> Float = {
    let rec a: Array<Float like Idx<18>> =
        match a with
        | zero -> zero
        | prefix :: j -> prefix :: __f4(c * 18 + j) * __c4te(n, j)
    reduce(a, (+)) + __f4(72 + c)
}
function hit_of(rung: Int, n: Int) -> Float = {
    if rung == 0 then hit(tescore0(n, 0), tescore0(n, 1), tescore0(n, 2), tescore0(n, 3), __yte(n))
    else (if rung == 1 then hit(tescore2(n, 0), tescore2(n, 1), tescore2(n, 2), tescore2(n, 3), __yte(n))
    else (if rung == 2 then hit(tescore3(n, 0), tescore3(n, 1), tescore3(n, 2), tescore3(n, 3), __yte(n))
    else hit(tescore4(n, 0), tescore4(n, 1), tescore4(n, 2), tescore4(n, 3), __yte(n))))
}
function cls_hits(rung: Int, c: Int) -> Float = {
    let rec a: Array<Float like Idx<50>> =
        match a with
        | zero -> zero
        | prefix :: k -> prefix :: hit_of(rung, c * 50 + k)
    reduce(a, (+))
}
let matrix_k0 = method_for(range<Idx<4>>) <@> lambda(c) -> cls_hits(0, c) |> compute
matrix_k0
// EXPECT: matrix_k0 = [50, 0, 0, 50]
let matrix_k2 = method_for(range<Idx<4>>) <@> lambda(c) -> cls_hits(1, c) |> compute
matrix_k2
// EXPECT: matrix_k2 = [0, 0, 50, 0]
let matrix_k3 = method_for(range<Idx<4>>) <@> lambda(c) -> cls_hits(2, c) |> compute
matrix_k3
// EXPECT: matrix_k3 = [13, 45, 50, 49]
let matrix_k34 = method_for(range<Idx<4>>) <@> lambda(c) -> cls_hits(3, c) |> compute
matrix_k34
// EXPECT: matrix_k34 = [50, 48, 50, 50]
let rung_totals = [reduce(matrix_k0, (+)), reduce(matrix_k2, (+)), reduce(matrix_k3, (+)), reduce(matrix_k34, (+))]
rung_totals
// EXPECT: rung_totals = [100, 50, 157, 198]
// Theorem 2's accuracy consequence, exact: the constant model collects one
// class's 50 test samples and nothing else.
let k2_hits_exactly_50 = ind(reduce(matrix_k2, (+)), 49.5) * ind(50.5, reduce(matrix_k2, (+)))
k2_hits_exactly_50
// EXPECT: k2_hits_exactly_50 = 1

// %% [markdown]
// ## Verification: the trained readout under fresh rotations
//
// The store bakes 8 Haar rotations from a seed no training data ever saw.
// For two test samples per class, rotate the raw Cartesian cloud, permute to
// the (y, z, x) feeding order, recompute the jet from scratch, push it
// through the frozen body, the calibration, and the TRAINED top-rung readout
// — and compare all four class scores against the unrotated ones. The pin
// counts score components that moved by more than 1e-12; certified
// invariance means the count is zero through the entire pipeline.

// %%
function rotcomp(k: Int, n: Int, u: Int) -> Float = {
    let pnt = u / 3
    let c = u - pnt * 3
    let src = (c + 1) - ((c + 1) / 3) * 3
    let __row = __cte(n)
    __rot(k, src * 3) * __row(pnt, 0) + __rot(k, src * 3 + 1) * __row(pnt, 1) + __rot(k, src * 3 + 2) * __row(pnt, 2)
}
function rotflat(k: Int, n: Int) -> Array<Float like Idx<NP3>> = {
    let rec q: Array<Float like Idx<360>> =
        match q with
        | zero -> zero
        | prefix :: u -> prefix :: rotcomp(k, n, u)
    q
}
// K1 of a centered cloud is zero under any rotation; the literal zeros in the
// K1 slots differ from the unrotated features' ~1e-17 measured means by far
// less than the 1e-12 gate.
function x4_rot(k: Int, n: Int) -> Array<Float like IrrepsIdx<ISPEC4>> = {
    let __j = jmean(rotflat(k, n))
    [__j(0), __j(16),
     0.0, 0.0, 0.0,
     __j(6), __j(7), __j(8),
     __j(1), __j(2), __j(3), __j(4), __j(5),
     __j(17), __j(18), __j(19), __j(20), __j(21),
     __j(9), __j(10), __j(11), __j(12), __j(13), __j(14), __j(15),
     __j(22), __j(23), __j(24), __j(25), __j(26), __j(27), __j(28), __j(29), __j(30)]
}
function rotscore(k: Int, n: Int, c: Int) -> Float = {
    let __e = chans4(x4_rot(k, n))
    let rec a: Array<Float like Idx<18>> =
        match a with
        | zero -> zero
        | prefix :: j -> prefix :: __f4(c * 18 + j) * ((__e(j) - __mu4(j)) * __sc4(j))
    reduce(a, (+)) + __f4(72 + c)
}
// u indexes (rotation 0..7) x (class 0..3) x (sample 0..1) x (score 0..3).
function vprobe(u: Int) -> Float = {
    let k = u / 32
    let rest = u - k * 32
    let cls = rest / 8
    let lcl = rest - cls * 8
    let smp = cls * 50 + (lcl / 4) * 25
    let c = lcl - (lcl / 4) * 4
    abs(rotscore(k, smp, c) - tescore4(smp, c))
}
let __vdev = method_for(range<Idx<256>>) <@> lambda(u) -> vprobe(u) |> compute
let rotation_bad = reduce(method_for(range<Idx<256>>) <@> lambda(u) -> ind(__vdev(u), 0.000000000001) |> compute, (+))
rotation_bad
// EXPECT: rotation_bad = 0
let rotation_total_dev = reduce(__vdev, (+))
rotation_total_dev

// %% [markdown]
// ## One refusal
//
// The l = 4 block of the jet is nine numbers, and reading the first of them
// looks like reading any other array element. Under `where ml.equiv(O3)` it
// is refused with BL4008 naming the read: those nine numbers are the
// components of a rank-4 tensor in a basis, and a rotation mixes them. The
// working code above never read one — `ml.norms` is the sanctioned exit.
// `examples/tetris_shapes.bladenb` runs the full deduction suite (six
// refusals, a compiler-written clause, a chirality theorem as a compile
// error).
//
// **This cell fails on purpose.** A failing cell never joins the notebook
// session, so nothing downstream is disturbed.

// %%
function leak(x: Array<Float like IrrepsIdx<ISPEC4>>) where ml.equiv(O3) -> Float =
    x(XL4)

// %% [markdown]
// ## What just happened
//
// The dataset was built so that "which moments carry the signal?" has a
// provable answer, and the proofs ran as pins: whitening residuals at the
// rounding floor across all 600 samples (summed residual ~1e-12 over the
// whole store); the K <= 2 feature vector's across-sample variance at
// ~2.5e-28 total, making the K <= 2 rung a constant function whose exact
// test count was predicted before its training cell ran; per-block
// attribution where the generator put it (octa's l = 0 gap thirteen orders
// below its l = 4 gap, heavy the reverse in dominance, tetra in K3 with its
// centrosymmetrized twin at literal zero); and the icosahedral clouds —
// exact vertices at anisotropy 1.8e-32, the sampled demo at the iso noise
// floor — invisible to every jet a K <= 4 compiler can build. The cap is a
// resolution statement with a symmetry class attached.
//
// The measured ladder: **100 / 50 / 157 / 198** hits out of 200, against
// the predicted staircase of ~100 / exactly 50 / ~150 / ~200. Three rows
// landed on the prediction, including both exact ones (K0's [50,0,0,50] and
// K <= 2's single-class 50), and heavy did separate a rung early, at +K3
// (49/50), by exactly the announced mechanism: kurtosis leaks into the
// sampling VARIANCE of the third-moment estimator — the mechanism exact
// whitening closes at K <= 2, reappearing one order up, visible to a norm
// channel and provably invisible to the linear ceiling (which sat at its
// shuffled-label null for that rung).
//
// Two honest findings beyond the prediction. First, the +K3 row read
// [13, 45, 50, 49]: iso and octa were predicted to share one winner
// (50 + 0), but the trained readout eked out a weak, real separation —
// 58/100 on the pair. The construction matches means and second moments of
// the K3 noise between iso and octa (the addition-theorem argument), but
// not its fourth moments: the variance-of-the-variance of a lobed cloud's
// K3 estimator differs from a smooth one's, and 100 training samples were
// enough for the norms to sip from that. A leak, quantified, exactly where
// the exactness devices stop. Second, octa gave up two samples at the top
// rung (48/50) — its l = 4 class signal is ~6x the per-sample noise, and
// two test clouds drew unlucky orientations of that noise.
//
// The door onward (`examples/cod_crystals.bladenb`): the same ladder on
// data where matched-moment structure occurs naturally rather than by
// construction — dMRI crossings (l = 4 at
// fixed tensor), EBSD/texture orientation distributions, Steinhardt-order
// analysis of supercooled liquids, water tetrahedrality (l = 3). This
// notebook is the control experiment those would cite.
