        | prefix :: j -> prefix :: (__e3tr(n, j) - __mu3(j)) * __sc3(j)
    o
}
function calrow3te(n: Int) -> Array<Float like Idx<15>> = {
    let rec o: Array<Float like Idx<15>> =
        match o with
        | zero -> zero
        | prefix :: j -> prefix :: (__e3te(n, j) - __mu3(j)) * __sc3(j)
