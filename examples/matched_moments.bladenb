}
let __sc3 = {
    let rec m: Array<Float like Idx<15>> =
        match m with
        | zero -> zero
        | prefix :: j -> prefix :: (if cal3sd(j) < 0.00000001 then 0.0 else 1.0 / cal3sd(j))
