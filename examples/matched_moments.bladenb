}
function cat4(__wn: Array<Float like Idx<NW4>>, __vn: Array<Float like Idx<NW4>>, lv: Float, k: Int) -> Float =
    if k < NW4 then __wn(k) else (if k < NW4X2 then __vn(k - NW4) else lv)
function step4(s: Array<Float like Idx<SW4>>, b: Int) -> Array<Float like Idx<SW4>> = {
    let mut ds = replicate(SW4, pure(0.0)) |> compute
    let lv = ad.grad(loss4)(s, b, ds)
    let vn = MU * blk4w(s, NW4) - LR * blk4w(ds, 0)
    let wn = blk4w(s, 0) + vn
    let rec o: Array<Float like Idx<153>> =
        match o with
        | zero -> zero
        | prefix :: k -> prefix :: cat4(wn, vn, lv, k)
    o
}
let __r4n = r.normal(31464, SW4)
let __s40 = {
    let rec m: Array<Float like Idx<SW4>> =
        match m with
        | zero -> zero
        | prefix :: k -> prefix :: (if k < NW4 then 0.1 * __r4n(k) else 0.0)
    m
}
let __tj4 = {
    let rec t: Array<Float like Idx<121>, Idx<SW4>> =
        match t with
        | zero -> zero
        | zero :: n -> zero :: __s40
        | prefix :: n -> prefix :: step4(prefix(n - 1), (n - 1) - ((n - 1) / 4) * 4)
    t
}
let __f4 = __tj4(NSTEP)
function l4_at(n: Int) -> Float = __tj4(n + 1)(NW4X2)
let loss4_curve = method_for(range<Idx<NSTEP>>) <@> lambda(n) -> l4_at(n) |> compute
